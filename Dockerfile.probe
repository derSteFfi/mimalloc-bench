ARG platform=ubuntu

FROM ubuntu:24.04 AS ubuntu


FROM fedora:44 AS fedora


FROM alpine:3.24 AS alpine
RUN apk add --no-cache bash


FROM ${platform} AS bench-env

# Pull mimalloc-bench
RUN mkdir -p /mimalloc-bench
COPY . /mimalloc-bench

WORKDIR /mimalloc-bench
# Install dependencies
RUN ./build-bench-env.sh packages

# Build benchmarks
RUN ./build-bench-env.sh bench

RUN ./build-bench-env.sh redis

RUN ./build-bench-env.sh rocksdb

RUN ./build-bench-env.sh lean

FROM bench-env AS benchmark

WORKDIR /mimalloc-bench

ARG allocator=mi
ARG benchs=cfrac
ARG repeats=1
# Bumped by the probe workflow so that the probe and benchmark steps are never
# served from the build cache (the base stages stay cached).
ARG probe_run=0

RUN ./build-bench-env.sh $allocator

# DEBUG PROBE (temporary, for investigating the ff/gs "cannot be preloaded"
# failures seen in CI): bracket the benchmark step with the diagnostic script
# ci-gs-probe.sh, which reports the security context of the sandbox and of the
# gs process itself and compares gs with other binaries.
RUN echo "probe run ${probe_run}" && bash ./ci-gs-probe.sh $allocator

# Run benchmarks
WORKDIR /mimalloc-bench/out/bench
RUN echo "probe run ${probe_run}" && ../../bench.sh $allocator $benchs -r=$repeats; rc=$?; \
    echo "== bench exited with rc=$rc =="; \
    bash /mimalloc-bench/ci-gs-probe.sh $allocator; \
    exit $rc
