ARG platform=ubuntu

FROM ubuntu:24.04 AS ubuntu


FROM fedora:44 AS fedora


FROM alpine:3.24 AS alpine
RUN apk add --no-cache bash


FROM ${platform} AS bench-env

# Pull mimalloc-bench
RUN mkdir -p /mimalloc-bench
COPY . /mimalloc-bench

WORKDIR /mimalloc-bench
# Install dependencies
RUN ./build-bench-env.sh packages

# Build benchmarks
RUN ./build-bench-env.sh bench

RUN ./build-bench-env.sh redis

RUN ./build-bench-env.sh rocksdb

RUN ./build-bench-env.sh lean

FROM bench-env AS benchmark

WORKDIR /mimalloc-bench

ARG allocator=mi
ARG benchs=cfrac
ARG repeats=1

RUN ./build-bench-env.sh $allocator

# DEBUG PROBE (temporary, for investigating the ff/gs "cannot be preloaded"
# failures seen in CI): bracket the benchmark step with allocator-directory
# listings, a forced-preload gs run, and kernel/security context snapshots.
RUN echo "== DEBUG pre-bench: allocator dir =="; ls -la extern/$allocator/; \
    echo "== DEBUG pre-bench: preload probe =="; \
    LD_PRELOAD=$(ls extern/$allocator/*.so 2>/dev/null | head -1) gs -dBATCH -dNODISPLAY extern/large.pdf 2>&1 | head -2; \
    echo "== DEBUG pre-bench: process context =="; grep -E "Seccomp|NoNewPrivs|CapEff" /proc/self/status; \
    cat /sys/kernel/security/apparmor/profiles 2>&1 | head -5; \
    dmesg 2>/dev/null | tail -4

# Run benchmarks
WORKDIR /mimalloc-bench/out/bench
RUN ../../bench.sh $allocator $benchs -r=$repeats; rc=$?; \
    echo "== DEBUG post-bench: bench rc=$rc, allocator dir =="; ls -la ../../extern/$allocator/; \
    echo "== DEBUG post-bench: preload probe =="; \
    LD_PRELOAD=$(ls ../../extern/$allocator/*.so 2>/dev/null | head -1) gs -dBATCH -dNODISPLAY ../../extern/large.pdf 2>&1 | head -2; \
    dmesg 2>/dev/null | grep -iE "denied|oom|segfault|truncat" | tail -6; \
    exit $rc
